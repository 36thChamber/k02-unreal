(fn Received_NotifyTick (MeshComp Animation FrameDeltaTime EventReference)
 (bind _owner (Components|GetOwner MeshComp))
 (if (not (== (Animation|GetCurrentMontage (Utilities|Casting|CastToCharacter _owner)) Animation)) (return true))
 (bind _pawn (Utilities|Casting|CastToPawn _owner))
 (if (Pawn|IsPlayerControlled _pawn)
  (bind _pc (Utilities|Casting|CastToBP_K02_PlayerController (Pawn|GetController _pawn)))
  (for _action (Variables|Default|GetInputActionstoContinueCombo)
   (for _key (Input|MappingQueries|QueryKeysMappedToAction (PlayerController|LocalPlayerSubsystems|GetEnhancedInputLocalPlayerSubsystem _pc) _action)
    (if (or (Game|Player|WasInputKeyJustPressed _pc _key) (Class|BPK02PlayerController|K02ConsumeBufferedKey _pc _key))
     (Ability|SendGameplayEventToActor _owner "(TagName=\"MACS_GAS.Abilities.Events.Combo.ToDo\")")
     (Ability|SendGameplayEventToActor _owner "(TagName=\"MACS_GAS.Abilities.Events.Combo.Check\")" (Utilities|Struct|MakeGameplayEventData "(TagName=\"\")" 0 0 0 0 "()" (Variables|Default|GetNextComboAbilitiesTAGs)))
     (return true))))
  (return true)
  (else
   (Ability|SendGameplayEventToActor _owner "(TagName=\"MACS_GAS.Abilities.Events.Combo.ToDo\")")
   (Ability|SendGameplayEventToActor _owner "(TagName=\"MACS_GAS.Abilities.Events.Combo.Check\")" (Utilities|Struct|MakeGameplayEventData "(TagName=\"\")" 0 0 0 0 "()" (Variables|Default|GetNextComboAbilitiesTAGs)))
   (return true))))
